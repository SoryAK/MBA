{
  "name": "mba",
  "version": "0.1.0",
  "description": "Model Behavioral Adapter (MBA) — per-model behavior framework, BCB/TCB engine, global config service, and MCP control plane",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "start:service": "npm run start --workspace @mba-ai/core",
    "mba": "npx tsx packages/core/src/cli/mba.ts"
  },
  "license": "Apache-2.0",
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
